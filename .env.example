# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Supabase
# (projeto novo, exclusivo do Mozii 2.0 — não reutilizar o projeto do fable/Mozi).
# Onde encontrar: Dashboard do Supabase → Project Settings → API.

# URL do projeto Supabase (ex.: https://abcdefghij.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" do projeto (segura para o navegador; a RLS protege os dados)
VITE_SUPABASE_ANON_KEY=

# Chave v3 da API do TMDB (https://www.themoviedb.org/settings/api)
# É uma chave pública por design — vai para o bundle, o TMDB limita por taxa.
VITE_TMDB_API_KEY=
